# BioStreamer configuration. Copy to .env and fill in.
#   cp .env.example .env
# .env is git-ignored; never commit real credentials.

# --- LLM (unified RAG layer) -----------------------------------------------
# Without a key the /chat endpoint degrades gracefully: it still returns ranked
# Qdrant passages and deterministic SQL aggregates, omitting only the synthesis
# step. Every other endpoint is unaffected.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=2048

# --- PostgreSQL (staging warehouse) ----------------------------------------
# Use localhost from the host; the Airflow container overrides this to
# POSTGRES_HOST=postgres via docker-compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=data_engineer
POSTGRES_PASSWORD=zoomcamp_secret_pass
POSTGRES_DB=biostream_db
BIOSTREAM_SCHEMA=bioprocess

# --- Qdrant (vector store) --------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=bioprocess_knowledge

# --- MinIO (S3 data lake) ---------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=adminpassword
MINIO_BUCKET=biostreamer-lake

# --- Embeddings -------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Simulation -------------------------------------------------------------
# The seed makes the dataset byte-for-byte reproducible. Changing it produces a
# different but equally valid dataset; the reference cohort still reproduces the
# published Table 2 means.
BIOSTREAM_SEED=20240423
BIOSTREAM_REACTORS=100
BIOSTREAM_DAYS=30
BIOSTREAM_START_DATE=2024-10-01

# --- API --------------------------------------------------------------------
BIOSTREAM_API_URL=http://localhost:8000
